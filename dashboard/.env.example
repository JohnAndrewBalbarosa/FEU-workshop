# --- Auth (server-only — NO NEXT_PUBLIC_ prefix) ---
# Generate the password hash locally with: npm run hash-password
# DO NOT COMMIT REAL VALUES. Set these in Vercel → Project → Settings → Environment Variables.
DASHBOARD_USERNAME=your-username-here
DASHBOARD_PASSWORD_HASH=$2a$12$replace-with-bcrypt-hash-from-hash-password-script

# 32+ random bytes, base64. Generate with:  openssl rand -base64 48
AUTH_SECRET=replace-with-32+-random-bytes-base64

# Cookie name (optional override)
AUTH_COOKIE_NAME=dash_session

# --- Vercel KV (auto-injected when you link a KV store in Vercel dashboard) ---
KV_URL=
KV_REST_API_URL=
KV_REST_API_TOKEN=
KV_REST_API_READ_ONLY_TOKEN=
